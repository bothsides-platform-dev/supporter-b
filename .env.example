# Local Postgres (docker compose `pg` service, port 5432).
DATABASE_URL=postgres://supporter_b:supporter_b@localhost:5432/supporter_b
# Test Postgres (docker compose pg-test profile). 로컬 통합 테스트 전용.
DATABASE_URL_TEST=postgres://supporter_b:supporter_b@localhost:5433/supporter_b_test

# 첨부파일 저장소 (Cloudflare R2). 4개 모두 설정 필요 — 하나라도 비면 getStorage()
# 가 throw 한다(폴백 백엔드 없음, 로컬 dev도 실 R2 버킷 사용). 단위 테스트는
# __setStorageForTest 로 mock을 주입하므로 이 값들 없이도 통과한다.
#
# 취득 방법 (Cloudflare 대시보드 — dash.cloudflare.com):
#   R2_ACCOUNT_ID        대시보드 우측 사이드바의 Account ID (R2 개요 페이지에도 노출)
#   R2_BUCKET            R2 → Create bucket 으로 생성한 버킷명.
#                        ⚠ 로컬은 prod와 분리된 dev 전용 버킷 사용 (예: supporter-b-attachments-dev)
#   R2_ACCESS_KEY_ID /   R2 → Manage API tokens → Create API token,
#   R2_SECRET_ACCESS_KEY 권한 "Object Read & Write" + 위 버킷 스코프로 발급.
#                        생성 직후 한 번만 표시되는 S3 클라이언트용
#                        Access Key ID / Secret Access Key 쌍을 복사.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Auth.js v5 JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Resend API key for transactional email (invitations, verify, notifications).
RESEND_API_KEY=
# Resend 발신자 주소. Resend 대시보드에서 인증된 도메인의 주소여야 함.
RESEND_FROM=send@supporter-b.store
# 신규 가입(입점 심사 요청) 시 승인요청 알림을 받을 운영자 메일 주소.
# ',' 로 여러 명 등록 가능 (예: ops@a.com, lead@b.com). 공백은 자동 trim.
# 미설정 시 알림 발송을 생략한다(가입 자체에는 영향 없음 — /admin 심사 큐에는 그대로 쌓임).
ADMIN_NOTIFY_EMAIL=

# 전자서명 라이프사이클(계약 대기 생성·발송·완료·거절/만료·취소) 운영자 알림용
# 디스코드 웹훅 URL. 디스코드 채널 설정 → 연동 → 웹훅에서 생성.
# 미설정 시 발송을 생략한다(기능에는 영향 없음 — dev 로그만 남김). 금액·수수료는 미포함.
DISCORD_WEBHOOK_URL=

# SolAPI SMS (휴대폰 OTP). console.solapi.com → API Key 관리
SOLAPI_API_KEY=
SOLAPI_SECRET_KEY=
# 사전 등록·승인된 발신번호 (010xxxxxxxx, 하이픈 없음)
SOLAPI_SENDER=

# 국세청 사업자등록 상태조회 service key (data.go.kr)
NTS_SERVICE_KEY=

# Public-facing origin (emailed links, redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Host routing (workspace별 호스트). buyer=support-b.com / pg=partner.support-b.com.
# 두 값이 같으면 라우팅 OFF(단일 호스트) — 로컬 기본값. (app)/layout 의 호스트
# 리다이렉트와 루트 랜딩의 PG 분기(app/page.tsx)가 이 값으로 호스트를 판별한다.
# 로컬에서 PG 랜딩/호스트 라우팅을 테스트하려면 partner 를 다른 호스트로:
#   NEXT_PUBLIC_PARTNER_ORIGIN=http://partner.localhost:3000
# (*.localhost 는 크롬/파폭이 127.0.0.1 로 자동 해석 → /etc/hosts 불필요)
NEXT_PUBLIC_BUYER_ORIGIN=http://localhost:3000
NEXT_PUBLIC_PARTNER_ORIGIN=http://localhost:3000

# 이메일 큐 주기 flush cron 인증 시크릿. POST /api/cron/flush-outbox 가
# 헤더 `x-cron-secret`(또는 `?secret=`) 값을 이 값과 비교해 일치할 때만 실행한다.
# 미설정/빈 값이면 라우트는 무조건 401(fail-closed) — 즉 cron 이 안 돈다.
# 강하게 생성: `openssl rand -base64 32`
CRON_SECRET=

# 마스터/운영자 계정 (Google OAuth 전용, 숨겨진 /login/ops 라우트).
# 로컬에선 보통 비워둠 — 실제 Google OAuth 클라이언트가 있어야 동작한다.
# AUTH_GOOGLE_ID 가 비어 있으면 Google 프로바이더는 등록되지 않는다.
# MASTER_ACCOUNT_EMAILS 는 쉼표로 여러 운영자 이메일을 넣을 수 있다.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
MASTER_ACCOUNT_EMAILS=
NEXT_PUBLIC_MASTER_OAUTH_ENABLED=

# Sentry DSN (sentry.io → Settings → Projects → [project] → Client Keys)
NEXT_PUBLIC_SENTRY_DSN=https://[key]@o[org-id].ingest.sentry.io/[project-id]
# Sentry DSN — 서버/Edge 런타임 전용. 없으면 NEXT_PUBLIC_SENTRY_DSN 사용.
SENTRY_DSN=
# Sentry org/project slugs for source map upload
SENTRY_ORG=
SENTRY_PROJECT=
# Sentry Auth Token (sentry.io → Settings → Auth Tokens). CI/배포 시 필요.
SENTRY_AUTH_TOKEN=

# Admin console (env-based, no DB table)
# ADMIN_SESSION_SECRET: `openssl rand -base64 32` 로 생성, 32자 이상 필수
ADMIN_ID=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 채널톡(Channel.io). Plugin Key는 Desk → 채널 설정 → 일반 → SDK 탭에서 확인.
NEXT_PUBLIC_CHANNEL_IO_PLUGIN_KEY=
# 채널톡 Secure mode HMAC secret. Desk → 채널 설정 → 보안 → 사용자 데이터 암호화 활성화 시 발급.
# 미설정 시 식별만 하고 hash 생략(개발 모드 동작).
CHANNEL_IO_SECRET=

# Google Analytics 4 measurement ID (GA 관리 → 데이터 스트림 → G-XXXXXXXXXX).
# 미설정 시 GA 스크립트 미로드(개발/프리뷰에서 생략 가능).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Axiom structured logging (app.axiom.co → Settings → API Tokens → Ingest 권한)
# 미설정 시 stdout fallback (로컬 개발에서 생략 가능)
AXIOM_TOKEN=
AXIOM_DATASET=
# next-axiom Web Vitals (NEXT_PUBLIC_ prefix required — browser-side)
NEXT_PUBLIC_AXIOM_TOKEN=
NEXT_PUBLIC_AXIOM_DATASET=

# Centrifugo (실시간 채팅 fanout). 로컬 dev 는 compose 프로필로 띄운다:
#   docker compose --profile realtime up -d centrifugo
# (docker-compose.yml 이 config.yaml 마운트 + dev 기본 env + proxy-secret 브리지까지 처리.
#  compose 없이 단독 docker run 이 필요하면 docs/DEPLOY_LIGHTSAIL.md §로컬 dev 참조.)
# 미설정 시 앱은 publish 를 no-op 으로 건너뜀 (채팅 영속은 동작, 라이브 fanout 만 비활성).
CENTRIFUGO_TOKEN_HMAC_SECRET=dev-secret
CENTRIFUGO_API_KEY=dev-api-key
# CENTRIFUGO_PROXY_SECRET: subscribe 프록시 공유 비밀 헤더 — 미설정 시 검증 생략 (dev 허용, prod 필수).
CENTRIFUGO_PROXY_SECRET=
CENTRIFUGO_HTTP_API_URL=http://127.0.0.1:8000/api
# WS URL 은 빌드 타임 인라인 — 변경 시 재빌드 필요.
NEXT_PUBLIC_CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket

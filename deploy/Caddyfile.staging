# Install instead of deploy/Caddyfile on the dedicated staging VM.
# STAGING_BASIC_AUTH_HASH belongs in /etc/caddy/caddy.env (caddy hash-password).
(staging-access) {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
}
(staging-auth) {
	basic_auth {
		tester {$STAGING_BASIC_AUTH_HASH}
	}
}

dev.support-b.com, partner.dev.support-b.com {
	import staging-access
	request_body {
		max_size 25MB
	}
	handle /connection/* {
		# Cross-host WebSockets cannot prompt for the buyer host's Basic Auth.
		# Centrifugo still requires the app-issued JWT and subscribe-proxy ACL.
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		import staging-auth
		reverse_proxy 127.0.0.1:3000
	}
}

# Optional: deploy admin-supporter-b separately, pointing at the staging DB.
admin.dev.support-b.com {
	import staging-access
	import staging-auth
	reverse_proxy 127.0.0.1:4242
}

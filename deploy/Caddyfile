# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
#
# APP_DOMAIN must resolve (A record -> Lightsail static IP) BEFORE Caddy starts,
# or the ACME challenge fails. Caddy redirects http://->https:// automatically.
#
#   sudo APP_DOMAIN=your-domain.com caddy run --config /etc/caddy/Caddyfile
# or via the systemd service after writing APP_DOMAIN into /etc/caddy/caddy.env.
{$APP_DOMAIN}, partner.{$APP_DOMAIN} {
	encode zstd gzip

	# Attachment bytes go browser -> R2 directly (presigned PUT) and no longer
	# pass through this proxy. The raised body limit remains for the app-proxied
	# uploads that are left: user avatar / workspace logo (5MB cap each).
	request_body {
		max_size 25MB
	}

	# Realtime chat WebSocket (Centrifugo). The browser connects to
	# wss://<domain>/connection/websocket; Caddy upgrades transparently and
	# proxies to the 127.0.0.1-bound Centrifugo container. NEXT_PUBLIC_CENTRIFUGO_WS_URL
	# points here. This is the ONLY Centrifugo path that is public — the
	# subscribe proxy (Centrifugo -> app) is server↔server and is NOT routed
	# here (it stays on the private app endpoint /api/centrifugo/subscribe).
	handle /connection/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Everything else -> the Next.js app (PM2).
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

admin.{$APP_DOMAIN} {
	encode zstd gzip

	reverse_proxy 127.0.0.1:4242
}

# --- Domain migration: supporter-b.com -> support-b.com (temporary) ---------
# APP_DOMAIN on the server must be support-b.com by the time this reloads.
# Old domain's DNS must stay pointed at this server or the redirect (and its
# cert renewal) breaks. {$APP_DOMAIN} below resolves to the NEW domain via env,
# so these blocks stay correct even if APP_DOMAIN changes again later.
# Remove once supporter-b.com traffic has died down (check access logs).
supporter-b.com {
	redir https://{$APP_DOMAIN}{uri} permanent
}

partner.supporter-b.com {
	redir https://partner.{$APP_DOMAIN}{uri} permanent
}

admin.supporter-b.com {
	redir https://admin.{$APP_DOMAIN}{uri} permanent
}

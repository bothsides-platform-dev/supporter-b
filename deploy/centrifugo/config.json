{
  "http_server": {
    "port": 8000
  },
  "client": {
    "token": {
      "hmac_secret_key": ""
    },
    "allowed_origins": []
  },
  "http_api": {
    "key": ""
  },
  "channel": {
    "proxy": {
      "subscribe": {
        "endpoint": "http://host.docker.internal:3000/api/centrifugo/subscribe",

# Copy to .env.production on the dedicated staging VM. Never copy production secrets.
# next build/start still use NODE_ENV=production; APP_ENV selects staging cookies.
APP_ENV=staging
APP_DOMAIN=dev.support-b.com
AUTH_URL=https://dev.support-b.com
AUTH_TRUST_HOST=true
AUTH_SECRET=
AUTH_COOKIE_DOMAIN=.dev.support-b.com
NEXT_PUBLIC_BASE_URL=https://dev.support-b.com
NEXT_PUBLIC_BUYER_ORIGIN=https://dev.support-b.com
NEXT_PUBLIC_PARTNER_ORIGIN=https://partner.dev.support-b.com
ADMIN_ORIGIN=https://admin.dev.support-b.com

POSTGRES_USER=supporter_b_staging
POSTGRES_PASSWORD=
POSTGRES_DB=supporter_b_staging
DATABASE_URL=postgres://supporter_b_staging:CHANGE_ME@127.0.0.1:5432/supporter_b_staging

# Development bucket/key, separate from production; shared with local development.
# Configure CORS for both staging hosts while preserving localhost origins.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dev-supporter-b

CENTRIFUGO_TOKEN_HMAC_SECRET=
CENTRIFUGO_API_KEY=
CENTRIFUGO_PROXY_SECRET=
CENTRIFUGO_HTTP_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_CENTRIFUGO_WS_URL=wss://dev.support-b.com/connection/websocket
CRON_SECRET=
BUSINESS_CALENDAR_API_KEY=

# Populate only with staging/test integrations; blank values do not simulate success.
RESEND_API_KEY=
RESEND_FROM=
ADMIN_NOTIFY_EMAIL=
SOLAPI_API_KEY=
SOLAPI_SECRET_KEY=
SOLAPI_SENDER=
PHONE_OTP_CHANNEL=sms
BUSINESS_ALIMTALK_ENABLED=false
NTS_SERVICE_KEY=
APICK_API_KEY=
SNOWSIGN_API_KEY=
SNOWSIGN_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_GUEST_CHANNEL_ID=
GUEST_RFP_SLACK_THREADS_ENABLED=false
NEXT_PUBLIC_GUEST_RFP_SLACK_THREADS_ENABLED=false
GUEST_RFP_AUTO_SEND_ENABLED=false

# Optional operator OAuth: use a separate client and staging callback URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
MASTER_ACCOUNT_EMAILS=
NEXT_PUBLIC_MASTER_OAUTH_ENABLED=false

# Keep production analytics, support inboxes and observability projects out of staging.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CHANNEL_IO_PLUGIN_KEY=
CHANNEL_IO_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
AXIOM_TOKEN=
AXIOM_DATASET=

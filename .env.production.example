# Production environment for the Lightsail instance.
#   cp .env.production.example .env.production   then fill every value.
# Next.js loads this file at BUILD and RUNTIME (NODE_ENV=production), and
# scripts/deploy/lightsail-deploy.sh also sources it for drizzle-kit. Keep it out of git.
#
# Do NOT use quotes around values that contain '+', '/', '=' (e.g. AUTH_SECRET) —
# the deploy script sources this file, so quoting/spacing must stay shell-safe.

# --- Database (local Postgres container, 127.0.0.1) -------------------------
# POSTGRES_* are read by docker-compose.prod.yml; DATABASE_URL by the app.
# All three must agree.
POSTGRES_USER=supporter_b
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=supporter_b
DATABASE_URL=postgres://supporter_b:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/supporter_b

# --- Auth.js v5 -------------------------------------------------------------
# AUTH_SECRET: generate with `openssl rand -base64 32`
AUTH_SECRET=
# REQUIRED on a non-Vercel host behind a reverse proxy, or login fails with
# "UntrustedHost". Caddy forwards X-Forwarded-Host/Proto, which Auth.js trusts.
AUTH_TRUST_HOST=true
# Your real HTTPS origin. Used by Auth.js and for building email/invite links.
AUTH_URL=https://your-domain.com

# --- Public base URL (inlined at BUILD time; rebuild if it changes) ---------
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# --- Reverse proxy ----------------------------------------------------------
# Consumed by deploy/Caddyfile ({$APP_DOMAIN}).
APP_DOMAIN=your-domain.com

# --- Email (Resend) ---------------------------------------------------------
# NOTE: invite/signup emails will NOT deliver until this domain is verified in
# Resend (DNS records). Until then the platform's PG-invite flow is inert.
# Add the records later, then set RESEND_FROM to an address on the verified domain.
RESEND_API_KEY=
RESEND_FROM=no-reply@your-domain.com
# 신규 가입 승인요청 알림을 받을 운영자 메일. ',' 로 여러 명 등록 가능 (미설정 시 알림만 생략).
ADMIN_NOTIFY_EMAIL=

# --- 국세청 사업자번호 enrichment (mandatory at RFP creation) ----------------
NTS_SERVICE_KEY=

# --- Sentry (optional) ------------------------------------------------------
# Leave SENTRY_AUTH_TOKEN blank to skip sourcemap upload during build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Channel.io (optional) --------------------------------------------------
NEXT_PUBLIC_CHANNEL_IO_PLUGIN_KEY=
CHANNEL_IO_SECRET=

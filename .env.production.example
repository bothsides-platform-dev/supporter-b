# Production environment for the Lightsail instance.
#   cp .env.production.example .env.production   then fill every value.
# Next.js loads this file at BUILD and RUNTIME (NODE_ENV=production), and
# scripts/deploy/lightsail-deploy.sh also sources it for drizzle-kit. Keep it out of git.
#
# Do NOT use quotes around values that contain '+', '/', '=' (e.g. AUTH_SECRET) —
# the deploy script sources this file, so quoting/spacing must stay shell-safe.

# --- Database (local Postgres container, 127.0.0.1) -------------------------
# POSTGRES_* are read by docker-compose.prod.yml; DATABASE_URL by the app.
# All three must agree.
POSTGRES_USER=supporter_b
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=supporter_b
DATABASE_URL=postgres://supporter_b:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/supporter_b

# --- 첨부파일 저장소 (Cloudflare R2) ------------------------------------------
# 첨부파일 바이트는 Cloudflare R2 에 저장(S3 호환 API, lib/server/storage/r2.ts).
# 4개 모두 설정 필요 — 하나라도 비면 모든 환경에서 getStorage() 가 throw 한다
# (폴백 백엔드 없음 — 로컬 dev 도 동일하게 실 R2 버킷을 쓴다. .env 에 같은 4개 변수를
# 넣어 두면 된다. 단위 테스트는 __setStorageForTest 로 mock 을 주입해 영향받지 않는다).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=supporter-b-attachments

# --- 전자서명 (SnowSign Public API) -----------------------------------------
# 선정 후 전자서명(lib/server/signing/snowsign-client.ts). 단일 API 키 = 1 org —
# 모든 PG 가 같은 org 를 공유한다. PG 간 격리는 계약 단위로 앱이 강제한다:
# 임베드 세션에 external_id(sc:<signingContractId>)를 심고, 바인딩할 때
# attachProviderContract 가 ACL + 재조회 + provider_ref 유일성으로 검증한다.
# 미설정 시 서명 관련 SnowSign 호출이 SNOWSIGN_NO_KEY 로 throw(서비스는 이를 감싸
# 화면을 막지 않되, award 후 계약 발송/폴링/다운로드는 동작하지 않는다). 단위 테스트는
# __setSnowSignClientForTest 로 mock 을 주입해 영향받지 않는다.
SNOWSIGN_API_KEY=
# 선택 — 기본값 https://api-snowsign.jtsnowball.com/public. 샌드박스/스테이징만 오버라이드.
# SNOWSIGN_API_URL=
# 웹훅 시크릿 — SnowSign 콘솔의 웹훅 설정에서 발급받은 키. POST /api/signing/webhook 가
# X-Webhook-Signature(HMAC-SHA256, raw body) 를 이 값으로 검증한다. 미설정이면 라우트가
# fail-closed 로 401(웹훅 무시) → 폴링 cron 만으로 상태 동기화(백스톱). 자세히는
# docs/DEPLOY_LIGHTSAIL.md "전자서명 웹훅" 절.
SNOWSIGN_WEBHOOK_SECRET=

# --- Auth.js v5 -------------------------------------------------------------
# AUTH_SECRET: generate with `openssl rand -base64 32`
AUTH_SECRET=
# REQUIRED on a non-Vercel host behind a reverse proxy, or login fails with
# "UntrustedHost". Caddy forwards X-Forwarded-Host/Proto, which Auth.js trusts.
AUTH_TRUST_HOST=true
# Your real HTTPS origin. Used by Auth.js and for building email/invite links.
AUTH_URL=https://your-domain.com

# --- Public base URL (inlined at BUILD time; rebuild if it changes) ---------
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# --- Reverse proxy ----------------------------------------------------------
# Consumed by deploy/Caddyfile ({$APP_DOMAIN}).
APP_DOMAIN=your-domain.com

# --- Email (Resend) ---------------------------------------------------------
# NOTE: invite/signup emails will NOT deliver until this domain is verified in
# Resend (DNS records). Until then the platform's PG-invite flow is inert.
# Add the records later, then set RESEND_FROM to an address on the verified domain.
RESEND_API_KEY=
RESEND_FROM=no-reply@your-domain.com
# Outbox delivery tuning (all optional — sane defaults shown). The outbox flush
# sends fan-outs via Resend's BATCH api (up to 100 emails per API call) so a
# burst of RFP invites / bid notifications stays under Resend's per-second rate
# limit. Failed sends back off exponentially and retry; permanent errors
# (bad address / unverified sender domain) fail fast.
#   EMAIL_BATCH_SIZE        emails per batch.send call (hard-capped at 100)
#   EMAIL_BATCH_INTERVAL_MS pause between consecutive batch calls in one flush
#   EMAIL_RETRY_BASE_MS     first-retry backoff window (grows 2^attempts)
#   EMAIL_RETRY_CAP_MS      max backoff window
# EMAIL_BATCH_SIZE=100
# EMAIL_BATCH_INTERVAL_MS=600
# EMAIL_RETRY_BASE_MS=30000
# EMAIL_RETRY_CAP_MS=1800000
# 신규 가입 승인요청 알림을 받을 운영자 메일. ',' 로 여러 명 등록 가능 (미설정 시 알림만 생략).
ADMIN_NOTIFY_EMAIL=

# --- Operator Discord alerts ------------------------------------------------
# 전자서명 라이프사이클(계약 대기 생성·발송·완료·거절/만료·취소) 운영자 알림용
# 디스코드 웹훅 URL. 디스코드 채널 설정 → 연동 → 웹훅에서 생성해 붙여넣는다.
# 미설정 시 발송만 생략(fail-open, 기능 무영향). 전송 실패는 Sentry(context: discord)로만 관측.
DISCORD_WEBHOOK_URL=

# --- Admin console (/admin) -------------------------------------------------
# 단일 공유 계정 — /admin/login 화면에서 사용.
# ADMIN_SESSION_SECRET: 32자 이상 랜덤 문자열, openssl rand -base64 32 로 생성.
# 미설정/단축 시 서버가 시크릿 설정 오류를 throw하며 admin 로그인이 불가능해진다.
# 값이 바뀌면 기존 admin-token 쿠키가 전부 무효화된다(재로그인 필요).
ADMIN_ID=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# 어드민 콘솔 기원 URL — 입점 심사 알림 메일의 "심사하러 가기" 링크 생성에 사용.
# 미설정 시 NEXT_PUBLIC_BASE_URL 으로 폴백.
ADMIN_ORIGIN=https://admin.support-b.com

# --- 국세청 사업자번호 enrichment (mandatory at RFP creation) ----------------
NTS_SERVICE_KEY=

# --- Sentry (optional) ------------------------------------------------------
# Leave SENTRY_AUTH_TOKEN blank to skip sourcemap upload during build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Axiom (operational/infra logs via pino, optional) ----------------------
# server-side pino(lib/observability/logger.ts)가 @axiomhq/pino transport로
# 운영 로그(server.start, email.sent, outbox.post_commit_failed 등)를 Axiom으로
# 직접 전송한다. 두 값이 모두 있어야 transport가 켜진다(없으면 stdout→`pm2 logs`).
AXIOM_TOKEN=
AXIOM_DATASET=

# --- Channel.io (optional) --------------------------------------------------
NEXT_PUBLIC_CHANNEL_IO_PLUGIN_KEY=
CHANNEL_IO_SECRET=

# --- Google Analytics 4 (optional) ------------------------------------------
# GA 관리 → 데이터 스트림 → 웹 → 측정 ID(G-XXXXXXXXXX). 빌드 타임에 인라인됨.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Centrifugo (realtime chat) ---------------------------------------------
# Self-hosted realtime fanout, runs as a 127.0.0.1-bound container alongside pg
# (docker-compose.prod.yml). Centrifugo persists nothing — Postgres is canonical.
#
# IMPORTANT — name bridge: docker-compose.prod.yml feeds these SAME values to the
# Centrifugo container under v6's nested-key env names. Set the value once here;
# both the app and the container consume it:
#   CENTRIFUGO_TOKEN_HMAC_SECRET -> container CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY
#   CENTRIFUGO_API_KEY           -> container CENTRIFUGO_HTTP_API_KEY
#   APP_DOMAIN (above)           -> container CENTRIFUGO_CLIENT_ALLOWED_ORIGINS=
#                                     "https://<domain> https://partner.<domain>"
#                                     (BOTH hosts — buyer apex + PG subdomain —
#                                      else PG WebSocket handshakes are rejected)
#
# CENTRIFUGO_TOKEN_HMAC_SECRET: HS256 key. The app signs the connection JWT
# (sub=userId) with it; Centrifugo verifies with the same key. Generate strong:
# `openssl rand -base64 48`. Channel access is NOT in this token — it is enforced
# by the subscribe proxy (app-side ACL).
CENTRIFUGO_TOKEN_HMAC_SECRET=
# CENTRIFUGO_API_KEY: authorizes the app's server-side HTTP publish to Centrifugo
# (X-API-Key header). Generate strong: `openssl rand -base64 48`.
CENTRIFUGO_API_KEY=
# CENTRIFUGO_PROXY_SECRET: 공유 비밀 헤더 — subscribe 프록시 엔드포인트(/api/centrifugo/subscribe)
# 가 인터넷에 노출되지 않도록 Centrifugo 가 보내는 X-Centrifugo-Proxy-Secret 값을 검증한다.
# 이 값 하나만 채우면 된다 — docker-compose 가 컨테이너에 CENTRIFUGO_VAR_PROXY_SECRET 로
# 브리지하고, config.yaml(proxy.subscribe.http.static_headers)이 ${CENTRIFUGO_VAR_PROXY_SECRET}
# 로 받아 헤더를 보낸다(Centrifugo v6.3.0+ map 추출). config.yaml 수동 편집 불필요.
# ⚠️ v5 키 proxy.subscribe.http_headers/static_http_headers 는 v6 가 "unknown key" 로
#    무시한다 — 그 형식으로 켜면 헤더가 안 나가 모든 subscribe 가 거부된다(2026-06-20 장애).
# 미설정(빈 값)이면 헤더 검사를 완전히 건너뛴다(하위호환 / Caddy ACL 단독 보호).
# 생성: openssl rand -base64 32
CENTRIFUGO_PROXY_SECRET=
# CENTRIFUGO_TOKEN_MAX_INFLIGHT: (선택, 기본 25) connection-token 라우트의 동시 발급
# 상한. 배포 시 Centrifugo 재시작 → 모든 탭이 ~1초 안에 재접속하며 토큰을 동시 요청한다.
# 이 상한을 넘으면 라우트가 auth/DB 를 건드리기 전에 503 + 지터된 Retry-After 로 흘려보내(load shed),
# 단일 Postgres 풀이 토큰 발급에 점유돼 비즈니스 트래픽이 굶는 것을 막는다(클라는 ky 재시도 +
# centrifuge-js 백오프로 자연히 분산 재시도). Postgres 풀 크기보다 작게 두는 것이 안전 —
# 재접속 폭주 부하 테스트 후 조정. 미설정이면 25.
# CENTRIFUGO_TOKEN_MAX_INFLIGHT=25
# CENTRIFUGO_HTTP_API_URL: where the app POSTs publish commands. Container is
# bound to 127.0.0.1:8000 and the app runs natively on the host, so localhost works.
CENTRIFUGO_HTTP_API_URL=http://127.0.0.1:8000/api
# NEXT_PUBLIC_CENTRIFUGO_WS_URL: browser WebSocket endpoint (inlined at BUILD time;
# rebuild if it changes). Routed by Caddy (/connection/*) to the container.
NEXT_PUBLIC_CENTRIFUGO_WS_URL=wss://your-domain.com/connection/websocket

# --- Outbox cron (이메일 큐 주기 flush) -------------------------------------
# 매 1분 crontab 이 POST /api/cron/flush-outbox 를 쳐서 이메일 큐를 비운다. 라우트는
# 헤더 `x-cron-secret`(또는 `?secret=`) 값이 이 시크릿과 일치할 때만 실행하고,
# 미설정/빈 값이면 무조건 401(fail-closed) — crontab 의 $CRON_SECRET 가 빈 값으로
# 펼쳐져도 우회되지 않는다(대신 flush 가 조용히 안 도니 값을 꼭 채울 것).
# 지연 chat 다이제스트는 post-commit 즉시 flush 로는 못 잡으므로 이 cron 이 필요하다.
# 강하게 생성: `openssl rand -base64 32`. 설정 방법은 docs/DEPLOY_LIGHTSAIL.md 참조.
CRON_SECRET=

# --- Buyer/PG host routing (partner.support-b.com) ---
# Share the session cookie across support-b.com and partner.support-b.com so a
# multi-workspace user stays logged in across both. Leave UNSET locally (host-only
# cookie on localhost). NOTE: changing this logs every user out once on rollout.
AUTH_COOKIE_DOMAIN=.support-b.com

# Per-host origins used by host routing (which host serves which workspace type) and
# by per-type email links (PG invitations link to the partner host). Unset locally =
# routing disabled (single host). NEXT_PUBLIC_* are inlined at BUILD time — rebuild
# after changing them, a plain restart is not enough.
#
# 둘은 반드시 **함께** 설정하거나 **둘 다 비운다**. 하나만 설정하면 appOrigins() 가
# 예외를 던진다 — 예전엔 나머지가 폴백으로 채워지며 "단일 호스트 dev" 로 위장했고,
# 그 상태에서 partner 호스트의 noindex(robots.txt + X-Robots-Tag)와 /login/ops 의
# OAuth PKCE 호스트 핀이 한꺼번에 조용히 꺼졌다.
NEXT_PUBLIC_BUYER_ORIGIN=https://support-b.com
NEXT_PUBLIC_PARTNER_ORIGIN=https://partner.support-b.com

# --- Pre-seeded canonical PG company master accounts ---
# Run `pnpm tsx scripts/seed-pg-companies.ts` after setting these.
# Accounts are system-managed (hidden from member lists).
SEED_PG_TOSSPAYMENTS_EMAIL=
SEED_PG_TOSSPAYMENTS_PASSWORD=
SEED_PG_KGINICIS_EMAIL=
SEED_PG_KGINICIS_PASSWORD=
SEED_PG_NICEPAYMENTS_EMAIL=
SEED_PG_NICEPAYMENTS_PASSWORD=
SEED_PG_KCP_EMAIL=
SEED_PG_KCP_PASSWORD=
SEED_PG_HECTOFINANCIAL_EMAIL=
SEED_PG_HECTOFINANCIAL_PASSWORD=
SEED_PG_DANAL_EMAIL=
SEED_PG_DANAL_PASSWORD=
SEED_PG_KICC_EMAIL=
SEED_PG_KICC_PASSWORD=

# --- Master/operator account (Google OAuth only) ---
# Operators sign in ONLY via Google at the hidden /login/ops route. No password.
# 1) Create a Google OAuth client (consent screen + credentials), authorized
#    redirect URI = https://support-b.com/api/auth/callback/google (one host;
#    the .support-b.com cookie shares the session to the partner host).
# 2) MASTER_ACCOUNT_EMAILS = comma-separated allowlist of operator Google emails
#    (multiple operators). A Google-verified email NOT on this list is rejected.
# 3) NEXT_PUBLIC_MASTER_OAUTH_ENABLED=true enables the hidden /login/ops route
#    (inlined at BUILD time — rebuild after changing). The route renders only when
#    BOTH this flag is true AND the Google client is fully set (AUTH_GOOGLE_ID +
#    AUTH_GOOGLE_SECRET — always set them as a PAIR; a half-set client 404s the
#    route and skips provider registration). This gates the UI entry point only —
#    the security boundary is the MASTER_ACCOUNT_EMAILS default-deny allowlist.
#    Whenever the pair is set the OAuth callback (/api/auth/callback/google)
#    exists regardless of this flag, but only allowlisted Google emails can
#    complete sign-in. To fully disable, unset AUTH_GOOGLE_ID.
# NOTE: always START master sign-in on the buyer host — /login/ops on the partner
#    host redirects to the buyer origin, because the OAuth PKCE/state cookies are
#    host-only while the callback URI above is pinned to the buyer host.
# No seed script — the master users row auto-provisions on first Google login.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
MASTER_ACCOUNT_EMAILS=help@support-b.com,ops@support-b.com
NEXT_PUBLIC_MASTER_OAUTH_ENABLED=true
